---
import BuildCard from "../components/BuildCard.astro";
import FluidInk from "../components/FluidInk.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BUILDS, INK, NEWS, SITE } from "../config";
import { getAllBuilds } from "../utils/builds";
import { getPublishedPosts } from "../utils/posts";
import { withBase } from "../utils/url";

const posts = (await getPublishedPosts()).slice(0, NEWS.postsOnHome);
const builds = (await getAllBuilds()).slice(0, BUILDS.buildsOnHome);
---

<BaseLayout overlayHeader>
  <FluidInk variant="hero" enabled={INK.hero}>
    <div class="hero">
      <p class="hero__eyebrow">FPV-Thüringen e.V.</p>
      <h1 class="hero__title">{SITE.title}</h1>
      <p class="hero__lede">{SITE.tagline}</p>
      <p class="hero__cta">
        <a href={withBase("/verein/")}>Mitglied werden ↓</a>
      </p>
    </div>

    {
      INK.hero && (
        <p class="hero__notes" aria-hidden="true">
          <span>Navier–Stokes / WebGL2</span>
          <span class="hero__notes-mid">Scrollen ↓</span>
          <span>Bewegen — Tusche verrühren</span>
        </p>
      )
    }
  </FluidInk>

  <section class="section wrap">
    <div class="latest__head">
      <h2 class="eyebrow">Aktuelles</h2>
      <a class="latest__all label" href={withBase("/news/")}>Alle News →</a>
    </div>

    <div class="latest__list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  {
    INK.divider && (
      <FluidInk variant="divider" strength={INK.strength * 0.7}>
        <p class="divider__label label">Tusche und Papier</p>
      </FluidInk>
    )
  }

  <section class="section wrap">
    <div class="latest__head">
      <h2 class="eyebrow">Builds</h2>
      <a class="latest__all label" href={withBase("/builds/")}>Alle Builds →</a>
    </div>

    <div class="build-grid rule-grid">
      {builds.map((build) => <BuildCard build={build} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-24) var(--gutter);
    text-align: center;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    font-family: var(--font-mono);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: var(--tracking-hero);
    text-transform: uppercase;
  }

  .hero__lede {
    max-width: 32rem;
    font-size: var(--text-md);
    color: var(--color-fg-muted);
  }

  .hero__cta a {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: var(--rule-width) solid var(--color-accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-accent);
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .hero__cta a:hover {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }

  /* These describe the simulation, so they only appear once it has actually
     started — not when it declined for reduced motion or missing WebGL2. The
     element tags itself with data-ink-active on boot. */
  .hero__notes {
    display: none;
    position: absolute;
    inset-inline: var(--gutter);
    bottom: var(--space-6);
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  :global(.ink:has([data-ink-active])) .hero__notes {
    display: flex;
  }

  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .latest__all {
    text-decoration: none;
  }

  .latest__all:hover {
    color: var(--color-accent);
  }

  .latest__list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .build-grid {
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    margin-top: var(--space-6);
  }

  .divider__label {
    margin: auto;
    text-align: center;
  }

  @media (max-width: 55rem) {
    .hero__notes-mid {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    :global(.ink:has([data-ink-active])) .hero__notes {
      display: none;
    }
  }
</style>
