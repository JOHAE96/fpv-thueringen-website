---
import type { GetStaticPaths, Page } from "astro";

import PageHeader from "../../components/PageHeader.astro";
import Pagination from "../../components/Pagination.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { NEWS } from "../../config";
import { getPublishedPosts, type Post } from "../../utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: NEWS.postsPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;

const title =
  page.currentPage > 1 ? `News — Seite ${page.currentPage}` : "News";
---

<BaseLayout
  title={title}
  description="Neuigkeiten, Berichte von Treffen und Wettbewerben rund um den Verein."
>
  <div class="wrap">
    <PageHeader
      eyebrow="Aktuelles"
      title="News"
      lede="Berichte von Treffen, Wettbewerben und Ausflügen — neueste zuerst."
    />

    <div class="post-list">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination page={page} label="News" />
  </div>
</BaseLayout>

<style>
  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }
</style>
