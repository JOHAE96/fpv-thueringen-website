---
import type { GetStaticPaths, Page } from "astro";

import PageHeader from "../../../../components/PageHeader.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostCard from "../../../../components/PostCard.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { NEWS } from "../../../../config";
import {
  collectTags,
  getPublishedPosts,
  postsByTag,
  type Post,
} from "../../../../utils/posts";
import { withBase } from "../../../../utils/url";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();

  return collectTags(posts).flatMap((tag) =>
    paginate(postsByTag(posts, tag.slug), {
      params: { tag: tag.slug },
      pageSize: NEWS.postsPerPage,
      props: { tagName: tag.name },
    }),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  tagName: string;
}

const { page, tagName } = Astro.props;

const suffix = page.currentPage > 1 ? ` — Seite ${page.currentPage}` : "";
---

<BaseLayout
  title={`#${tagName}${suffix}`}
  description={`Beiträge mit dem Tag ${tagName}.`}
>
  <div class="wrap">
    <PageHeader
      eyebrow="Getaggt"
      title={`#${tagName}`}
      lede={`${page.total} ${page.total === 1 ? "Beitrag" : "Beiträge"} unter diesem Tag.`}
    >
      <p class="tag-page__back label">
        <a href={withBase("/news/tags/")}>← Alle Tags</a>
      </p>
    </PageHeader>

    <div class="post-list">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination page={page} label={`Beiträge mit #${tagName}`} />
  </div>
</BaseLayout>

<style>
  .tag-page__back {
    margin-top: var(--space-6);
  }

  .tag-page__back a {
    text-decoration: none;
  }

  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }
</style>
