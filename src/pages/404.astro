---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Diese Seite existiert nicht oder wurde verschoben."
>
  <section class="notfound wrap">
    <p class="notfound__code" aria-hidden="true">404</p>

    <h1 class="notfound__title">Hier ist nichts</h1>
    <p class="lede notfound__lede">
      Die gesuchte Seite existiert nicht oder wurde verschoben.
    </p>

    <p class="notfound__actions label">
      <a href={withBase("/")}>Startseite</a>
      <span aria-hidden="true">·</span>
      <a href={withBase("/news/")}>News</a>
      <span aria-hidden="true">·</span>
      <a href={withBase("/builds/")}>Builds</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 60svh;
    padding-block: var(--space-24);
    text-align: center;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .notfound__title {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
  }

  .notfound__lede {
    max-width: 32rem;
    margin-top: var(--space-4);
  }

  .notfound__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .notfound__actions a {
    text-decoration: none;
  }

  .notfound__actions a:hover {
    color: var(--color-accent);
  }
</style>
